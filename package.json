{
  "name": "@viamedici-spc/configurator-ts",
  "version": "0.0.0",
  "description": "TypeScript library to build configurator web applications based on the Viamedici Headless Configuration Engine (HCE).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamedici-spc/configurator-ts.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "swagger": "node scripts/swaggerGeneration.mjs",
    "typecheck": "bun check && bun check -p tests",
    "verify:package": "bun run build && publint --strict && attw --pack . --profile esm-only --format table-flipped"
  },
  "keywords": [
    "viamedici",
    "product",
    "configuration",
    "spc",
    "hce",
    "csp",
    "constraint",
    "satisfaction",
    "problem",
    "solver"
  ],
  "author": "Viamedici Software GmbH",
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/spark-md5": "^3.0.4",
    "jest-extended": "^4.0.2",
    "publint": "^0.3.25",
    "swagger-typescript-api": "^13.0.3",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2",
    "vitest": "^2.1.1",
    "wait-for-expect": "^3.0.2"
  },
  "dependencies": {
    "@morphic-ts/batteries": "^3.0.0",
    "@viamedici-spc/fp-ts-extensions": "^1.2.0",
    "dyna-guid": "^2.1.2",
    "fast-equals": "^2.0.0",
    "fp-ts": "^2.16.5",
    "memize": "^2.1.0",
    "p-defer": "^4.0.1",
    "spark-md5": "^3.0.2",
    "ts-pattern": "^5.0.6",
    "tslib": "^2.7.0",
    "xstate": "^5.17.4"
  },
  "inlinedDependencies": {
    "@morphic-ts/adt": "3.0.0",
    "@morphic-ts/common": "3.0.0",
    "@morphic-ts/model-algebras": "3.0.0",
    "@morphic-ts/summoners": "3.0.0",
    "monocle-ts": "2.3.13"
  }
}
