# Environment for the contract tests (tests/area/contract/ConfigurationSession.test.ts), which run against the live
# engine. Copy this file to .env.test.local (git-ignored; bun test loads it) and fill in the values.

# Access token for the test deployments "Configurator-TS-*". The maintainers hand it out.
HCA_ENGINE_ACCESS_TOKEN=

# Optional: another engine endpoint than the one in tests/config.json.
# HCA_ENGINE_ENDPOINT=
